DISCORD_TOKEN=

# The server the bot counts words in.
GUILD_ID=

# Optional. Channel for the welcome message when someone joins. Leave it empty for no message.
WELCOME_CHANNEL_ID=

# Users allowed to add and remove words, separated by commas.
ADMIN_IDS=

# Set to true to count the full server history on startup.
SCAN_HISTORY=false

DATABASE_URL=postgresql://user:password@host:5432/word_counter

# Docker only. The bot's IP on the br0 network. Pick a free one outside your router's DHCP range.
BOT_IP=
